<% content_for :title, "ユーザー設定" %>
<div class="container-app" style="max-width: 480px;">
  <h1 class="h4 mb-4">ユーザー設定</h1>

  <div class="card card-summary p-4">
    <%= form_with url: "/settings/profile", method: :post, local: true do |f| %>
      <div class="mb-3">
        <label for="display_name" class="form-label">表示名</label>
        <%= f.text_field :display_name, id: "display_name", name: "display_name",
                          value: current_user.display_name, class: "form-control", maxlength: 50 %>
      </div>
      <%= f.submit "更新する", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
