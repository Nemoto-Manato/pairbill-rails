<% content_for :title, "月次精算一覧" %>
<div class="container-app" style="max-width: 640px;">
  <h1 class="h4 mb-4">月次精算一覧</h1>

  <div class="card card-summary">
    <table class="table align-middle mb-0">
      <thead>
      <tr>
        <th>対象月</th>
        <th>状態</th>
        <th></th>
      </tr>
      </thead>
      <tbody>
      <% @months.each do |m| %>
        <tr>
          <td><%= m.year_month_label %></td>
          <td><span class="badge badge-status-<%= m.status %>"><%= m.status_label %></span></td>
          <td><a href="<%= settlement_month_path(m.year_month_value) %>" class="btn btn-sm btn-outline-primary">確認する</a></td>
        </tr>
      <% end %>
      <% if @months.empty? %>
        <tr><td colspan="3" class="text-center text-muted">対象月がありません。</td></tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
